{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AlphaVantage": {
    "ApiKey": "YOUR_API_KEY",
    "Timeout": "00:00:20"
  },
  "PricePolling": {
    "Interval": "00:01:00",
    "MarketHoursOnly": true
  },
  "MarketData": {
    "Provider": "MarketDataApp"
  },
  "MarketDataApp": {
    "ApiToken": "YOUR_API_TOKEN",
    "Timeout": "00:00:20",
    "OptionsTimeout": "00:00:30"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=DATABASE_NAME;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "",
    "Password": "",
    "VirtualHost": ""
  },
  "Database": {
    "MaxRetryCount": 3,
    "MaxRetryDelay": "00:00:05"
  },
  "Health": {
    "Period": "00:00:15"
  }
}
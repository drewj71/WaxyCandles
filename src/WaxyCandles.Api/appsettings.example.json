{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "",
    "Password": "",
    "VirtualHost": "",
    "PrefetchCount": 10
  },
  "MarketData": {
    "Provider": "MarketDataApp"
  },
  "MarketDataApp": {
    "ApiToken": "YOUR_API_TOKEN",
    "Timeout": "00:00:20",
    "OptionsTimeout": "00:00:30"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=DATABASE_NAME;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Database": {
    "MaxRetryCount": 3,
    "MaxRetryDelay": "00:00:05"
  },
  "Jwt": {
    "Issuer": "YOUR_ISSUER",
    "Audience": "YOUR_AUDIENCE",
    "Secret": "YOUR_JWT_KEY",
    "ExpirationMinutes": 60
  }
}